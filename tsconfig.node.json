{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "out/tsc-node",
    "paths": {
      "googleapis": ["./src/types/googleapis.ts"],
      "google-auth-library": ["./src/types/google-auth-library.ts"]
    }
  },
  "include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/types/**/*", "tests/**/*", "vitest.config.ts"]
}
